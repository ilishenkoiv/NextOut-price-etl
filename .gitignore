# dependencies
node_modules/

# secrets — never commit tokens/keys (they come from env / GitHub Secrets)
.env
.env.local
.env.*.local

# logs / os
*.log
.DS_Store
__pycache__/
*.pyc

# price snapshots — uploaded to the private `price-snapshots` Supabase Storage bucket by
# scripts/fetch-prices.mjs, no longer committed here. Files already in history are left
# alone on purpose (no git rm yet — that decision is still open).
snapshots/

# per-job snapshot validation trace, written to the workspace root by fetch-prices.mjs and
# uploaded as a CI artifact for the watchdog job. Never belongs in a commit.
snapshot-report-*.json

# curated destination photos — downloaded/generated locally, NOT committed (public repo).
# Includes candidates, optimized WebP, manifest.json, selected.json, review.html.
photos/

# Large local Copernicus downloads/intermediates. The compact verified JSON and generated SQL
# migration remain tracked as the reproducible release payload.
data/copernicus-weekly/
data/weather-weekly-normals.partial.json

# ad-hoc local analytics over the collected tables — read-only throwaway tooling, run by hand
# against a live database. Not part of the pipeline and not meant for a public repository.
scripts/report-prices.mjs
scripts/report-print.cjs

# local tooling
.claude/
